# Plantilla de credenciales para el Secret de Kubernetes.
#
#     cp k8s/.env.k8s.example k8s/.env.k8s
#
# k8s/.env.k8s está ignorado por git. kustomize lo convierte en el Secret
# wazuh-llm-secrets (con sufijo hash, así que cambiar una credencial dispara
# un rollout automático del Deployment).
#
# OJO: los nombres de las claves de las APIs son GEMINI_API_KEY / GROQ_API_KEY,
# tal y como los lee el código (middleware.py:178 y :197). El README del
# proyecto documenta WZ_GEMINI_KEY / WZ_GROQ_KEY, que están obsoletos.

# Contraseña del usuario de la API de gestión de Wazuh (WZ_API_USER)
WZ_API_PASS=

# Contraseña del usuario del Indexer / OpenSearch (WZ_INDEXER_USER)
WZ_INDEXER_PASS=

# Proveedores externos — dejar vacío si solo se usa Ollama
GEMINI_API_KEY=
GROQ_API_KEY=
